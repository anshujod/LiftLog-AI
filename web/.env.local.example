# Base URL the browser calls directly for API requests (needs CORS on the backend).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL the Next.js server (route handlers, proxy) calls. Usually the same value,
# but kept separate so a container setup can point it at an internal service name
# (e.g. http://api:8000) while the browser still uses the public URL above.
API_BASE_URL=http://localhost:8000
