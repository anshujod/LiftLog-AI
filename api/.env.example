DATABASE_URL=postgresql+psycopg://liftlog:liftlog@db:5432/liftlog
AUTH_SECRET=change-me-to-a-long-random-string
# Google OAuth client ID (Web application) used to verify Sign in with Google
# ID tokens. Empty disables POST /auth/google (it returns 401).
GOOGLE_CLIENT_ID=
AI_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
# anthropic (default) or openrouter. Empty AI_BASE_URL means the provider default
# (official Anthropic API, or https://openrouter.ai/api/v1 for openrouter).
AI_PROVIDER=anthropic
AI_BASE_URL=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
